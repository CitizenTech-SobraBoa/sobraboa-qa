  "item": [
    {
      "name": "F01 - Autenticação e Cadastro de Usuários",
      "item": [
        {
          "name": "TC-F01-01P — Cadastro de novo usuário com dados válidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var ts = Date.now();\r\npm.collectionVariables.set(\"email_cadastro\", \"qa_doador_\" + ts + \"@teste.com\");\r\npm.collectionVariables.set(\"cnpj_cadastro\", ts.toString().slice(-14).padStart(14, \"1\"));\r\npm.collectionVariables.set(\"nome_fantasia_cadastro\", \"Padaria QA \" + ts);\r\npm.collectionVariables.set(\"razao_social_cadastro\", \"Teste QA Alimentos \" + ts + \" LTDA\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Doador QA Teste\",\n  \"email\": \"{{email_cadastro}}\",\n  \"telefone\": \"11999990001\",\n  \"senha\": \"Senha@123\",\n  \"nomeFantasia\": \"{{nome_fantasia_cadastro}}\",\n  \"razaoSocial\": \"{{razao_social_cadastro}}\",\n  \"cnpj\": \"{{cnpj_cadastro}}\",\n  \"tipoEstabelecimento\": \"Padaria\",\n  \"endereco\": {\n    \"logradouro\": \"Rua das Flores\",\n    \"numero\": \"100\",\n    \"bairro\": \"Centro\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"cep\": \"01000-000\",\n    \"latitude\": -23.55052,\n    \"longitude\": -46.633308\n  },\n  \"aceitouTermos\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/registro/doador",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "registro",
                "doador"
              ]
            }
          },
          "response": []
        },
        {
